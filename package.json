{
  "name": "ucsd-decorator-kit",
  "version": "2.1.0",
  "type": "module",
  "description": "Agent-facing contract for building on the UC San Diego Decorator 5 design system.",
  "keywords": [
    "ucsd",
    "decorator",
    "design-system",
    "accessibility",
    "wcag",
    "bootstrap",
    "ai-agents"
  ],
  "homepage": "https://github.com/UCSD/decorator-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UCSD/decorator-kit.git"
  },
  "bugs": {
    "url": "https://github.com/UCSD/decorator-kit/issues"
  },
  "bin": {
    "ucsd-decorator-kit": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "scripts/lib",
    "scripts/pin-decorator.mjs",
    "rules",
    "skills",
    "contracts",
    "checks",
    "templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "compile": "node scripts/compile-rules.mjs",
    "check:library": "node scripts/check-library.mjs",
    "pin:decorator": "node scripts/pin-decorator.mjs",
    "test": "node scripts/compile-rules.mjs --check && node scripts/check-library.mjs && node --test test/*.test.mjs",
    "sync:library": "node scripts/sync-library.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
